# ==============================================================================
# QFedAutoML Environment Configuration
# ==============================================================================

# --- Application Settings ---
APP_NAME=QFedAutoML
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-secure-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=postgresql://qfed_user:qfed_password@localhost:5432/qfed_db
# For lightweight local testing without PostgreSQL:
# DATABASE_URL=sqlite:///./qfedautoml.db

# --- Federated Learning ---
FL_SERVER_HOST=0.0.0.0
FL_SERVER_PORT=8080
FL_MIN_CLIENTS=2
FL_DEFAULT_ROUNDS=5

# --- Quantum Simulators ---
# Simulators only by default: 'qiskit_aer' | 'pennylane_default'
QUANTUM_SIMULATOR_BACKEND=qiskit_aer
QUANTUM_MAX_QUBITS=16
QUANTUM_HARDWARE_ENABLED=false
IBM_QUANTUM_API_TOKEN=

# --- Privacy & Security ---
DP_EPSILON_DEFAULT=1.0
DP_DELTA_DEFAULT=1e-5
DP_MAX_GRAD_NORM=1.0
ENABLE_THREAT_DETECTION=true

# --- Logging & Monitoring ---
LOG_LEVEL=INFO
ENABLE_PROMETHEUS_METRICS=true
